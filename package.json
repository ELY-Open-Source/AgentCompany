{
  "name": "agent-company",
  "version": "0.4.182",
  "private": true,
  "type": "module",
  "description": "Cross-platform Electron desktop control plane for local-first AI agent companies.",
  "author": {
    "name": "AgentCompany",
    "email": "dev@agentcompany.ai"
  },
  "main": "out/main/index.js",
  "scripts": {
    "assets:generate": "python3 scripts/icons/generate-icons.py",
    "dev": "electron-vite dev",
    "build:verify": "electron-vite build",
    "build": "electron-vite build && node scripts/build-desktop.mjs",
    "build:dir": "electron-vite build && node scripts/build-desktop.mjs --dir",
    "build:current": "node scripts/build-all-platforms.mjs",
    "release:cloudflare": "node scripts/release-public-cloudflare.mjs && node scripts/release-boss.mjs",
    "release:cloudflare:public": "node scripts/release-public-cloudflare.mjs",
    "release:boss": "node scripts/release-boss.mjs",
    "release:local": "node scripts/release-local.mjs",
    "release:local-mac": "node scripts/release-local-mac.mjs",
    "release:local-winlinux": "node scripts/release-local-winlinux.mjs",
    "release:website": "node scripts/release-website.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:deps": "pnpm audit && npm --prefix landing audit --omit=dev",
    "test": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/unit",
    "test:integration": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/integration",
    "test:eval": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/eval",
    "eval:record": "node --disable-warning=ExperimentalWarning --experimental-strip-types tests/eval/record-fixture.ts",
    "test:e2e": "node --no-warnings ./node_modules/@playwright/test/cli.js test -c tests/e2e/playwright.config.ts",
    "test:run": "pnpm test:unit && pnpm test:integration && pnpm test:eval && pnpm test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm test:integration && pnpm test:eval && pnpm test:e2e",
    "verify:release": "pnpm audit:deps && pnpm verify && pnpm build:dir",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "0.67.68",
    "@mariozechner/pi-ai": "0.67.68",
    "@mariozechner/pi-coding-agent": "0.67.68",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "^3.13.23",
    "electron-log": "5.4.3",
    "electron-updater": "6.8.3",
    "framer-motion": "12.36.0",
    "js-tiktoken": "1.0.21",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.1",
    "remark-gfm": "^4.0.1",
    "zod": "4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/lib-storage": "^3.1047.0",
    "@eslint/js": "9.38.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "4.2.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "39.8.5",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "^7.3.2",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "@anthropic-ai/sdk@>=0.79.0 <0.91.1": "0.91.1",
      "@protobufjs/utf8@<=1.1.0": "1.1.1",
      "@xmldom/xmldom@<0.8.13": "0.8.13",
      "basic-ftp@<=5.3.0": "5.3.1",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=5.0.0 <5.0.5": "5.0.5",
      "fast-uri@<=3.1.1": "3.1.2",
      "fast-xml-builder@<=1.1.6": "1.2.0",
      "fast-xml-parser@<5.7.0": "5.8.0",
      "flatted@<=3.4.1": "3.4.2",
      "ip-address@<=10.1.0": "10.1.1",
      "lodash@<=4.17.23": "4.18.1",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.10": "8.5.14",
      "protobufjs@<=7.5.5": "7.5.6",
      "uuid@>=11.0.0 <11.1.1": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
