# Cloudflare R2 release hosting (Wrangler OAuth is used for bucket/bootstrap/upload)
# If left empty, release-local will discover/fill what it can via `npx wrangler`.
R2_ACCOUNT_ID=
R2_BUCKET=agentcompany-updates
R2_PUBLIC_BASE_URL=
AGENTCOMPANY_RELEASE_PREFIX=AC

# Optional override. When left empty, release-local derives:
# ${R2_PUBLIC_BASE_URL}/${AGENTCOMPANY_RELEASE_PREFIX}
AGENTCOMPANY_UPDATE_URL=

# Public-release macOS signing / notarization
# Supply either:
# - CSC_LINK=<path-or-url-to-Developer-ID-Application.p12>
# - CSC_KEY_PASSWORD=<p12 password>
# or, if you already imported the cert+private-key into Keychain:
# - CSC_NAME="<Legal Name> (<TEAMID>)"
CSC_LINK=
CSC_KEY_PASSWORD=
CSC_NAME=

# Choose one notarization method:
# 1) Apple ID + app-specific password
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# 2) App Store Connect API key
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=

# Optional Windows signing
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
